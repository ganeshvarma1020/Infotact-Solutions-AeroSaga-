# ========================================================
# AeroSaga Platform - Environment Variables Template
# Copy this file to .env or set these in your local environment.
# ========================================================

# --- MySQL Database Configuration ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=aerosaga_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password_here

# --- Server Port ---
SERVER_PORT=8080

# --- JWT Authentication ---
# 256-bit Hexadecimal secret key for signing tokens
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250655368566D5970
JWT_EXPIRATION_MS=86400000

# --- CORS Allowed Origins ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Temporal.io Workflow Server ---
TEMPORAL_TARGET=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
