# Copy this file to .env on the server and replace EVERY value.
# Generate strong passwords with:  openssl rand -base64 24
# Never commit the real .env file.

# Public name of the server (Azure DNS label, or your own domain pointed at the server IP)
DOMAIN=aerosaga-yourname.centralindia.cloudapp.azure.com

# Database credentials (used by both postgres and the app)
DB_USER=aerosaga
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# Dashboard / API login
AEROSAGA_USER=operator
AEROSAGA_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# 1.0 = real flight time, 0.05 = 20x faster (good for demos)
AEROSAGA_TIME_SCALE=0.05
