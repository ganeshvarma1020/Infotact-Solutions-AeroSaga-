{
  "name": "AeroSaga Drone Mission Control",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "AeroSaga Mission Control",
      "onAutoForward": "openBrowser",
      "elevateIfNeeded": true
    }
  },
  "updateContentCommand": "chmod +x mvnw && ./mvnw clean compile -DskipTests",
  "postStartCommand": "nohup ./mvnw spring-boot:run > aerosaga.log 2>&1 &",
  "customizations": {
    "vscode": {
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-21",
            "path": "/usr/local/sdkman/candidates/java/current",
            "default": true
          }
        ]
      },
      "extensions": [
        "vscjava.vscode-java-pack",
        "pivotal.vscode-boot-dev-pack"
      ]
    }
  }
}
