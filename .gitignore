# ========================================================
# AeroSaga Root Git Ignore Rules
# ========================================================

# --- Sensitive Configuration & Local Overrides ---
*.env
!*.env.example
application-local.yml
**/application-local.yml
*.local

# --- Java & Maven Build Artifacts ---
target/
**/target/
*.class
*.jar
*.war
*.ear
.mvn/timing.properties

# --- Node & Frontend Dependencies / Builds ---
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- Large Archives & Compressed Files ---
*.zip
*.tar
*.gz
*.rar

# --- IDE & Editor Settings ---
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# --- Operating System Files ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Logs ---
*.log
logs/
**/logs/
